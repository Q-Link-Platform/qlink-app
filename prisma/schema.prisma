generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  scheduledMessages ScheduledMessage[] @relation("UserScheduledMessages")
  id            String   @id @default(cuid())
  name          String?
  email         String?   @unique
  phoneNumber   String?   @unique
  image         String?
  googleId      String?   @unique
  emailVerified DateTime?
  handle        String?   @unique
  bio           String?
  banner        String?
  location      String?
  website       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  aura_percentage Float?   @default(0)
  lastSeenAt    DateTime?
  lastTypingAt  DateTime?
  lastTypingForHandle String?
  blue_tick_status String? @default("NONE")
  points        Int?      @default(0)
  sessionToken  String?
  hasClaimedReferral Boolean  @default(false)
  referredById       String?
  publicKeyString    String?
  encryptedPrivateKey String?

  accounts              Account[]
  sessions              Session[]
  pushSubscriptions     PushSubscription[]
  messages              Message[]      @relation("UserMessages")
  friendRequestsSent     FriendRequest[] @relation("FriendRequestsFrom")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsTo")
  posts                 Post[]
  reactions             Reaction[]     @relation("UserReactions")
  comments              Comment[]      @relation("UserComments")
  views                 View[]         @relation("UserViews")
  following             Follow[]       @relation("UserFollowing")
  followers             Follow[]       @relation("UserFollowers")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  ext_expires_in    Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Message {
  id          String    @id @default(cuid())
  content     String
  createdAt   DateTime  @default(now())
  status      String    @default("SENT")
  deliveredAt DateTime?
  readAt      DateTime?
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  reactions   String?

  senderId String
  sender   User     @relation("UserMessages", fields: [senderId], references: [id])

  // For now, simple two-party room id; later we can model threads/rooms
  roomId String
}

model FriendRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String

  // Comma-separated categories, but UI will enforce max 2 selections
  categories String
  message    String?

  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("FriendRequestsFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("FriendRequestsTo", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
}

model Post {
  id            String   @id @default(cuid())
  text          String
  audience      String
  attachmentId  String?
  attachmentKind String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reactions Reaction[]
  comments  Comment[]
  views     View[]

  @@index([authorId])
  @@index([expiresAt])
}

model Reaction {
  id     String @id @default(cuid())
  type   String // LIKE, LOVE, LAUGH, etc.
  
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId String
  user   User   @relation("UserReactions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  authorId String
  author   User   @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model View {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId String
  user   User   @relation("UserViews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  followerId String
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  
  followingId String
  following  User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
model ScheduledMessage {
  id              String   @id @default(cuid())
  senderId        String
  recipientHandle String
  roomId          String?
  content         String
  executeAt       DateTime
  status          String   @default("PENDING") // PENDING, SENT, CANCELLED, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sender User @relation("UserScheduledMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([executeAt, status])
  @@index([senderId])
}

model Attachment {
  id           String   @id @default(cuid())
  messageId    String?
  roomId       String?
  senderId     String?
  postId       String?
  kind         String   // "file" | "image" | "video"
  bucket       String
  objectKey    String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  status       String   @default("uploaded") // uploaded | deleted | failed
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs AttachmentLog[]

  @@index([messageId])
  @@index([postId])
}

model AttachmentLog {
  id           String   @id @default(cuid())
  attachmentId String
  event        String   // upload | download | delete
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([attachmentId])
}

